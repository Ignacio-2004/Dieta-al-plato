<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#DDE9EFDF"
    android:padding="16dp">

    <!-- TÍTULO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/bttReturn"
            android:layout_height="45dp"
            android:layout_width="100dp"
            android:backgroundTint="#00FFFFFF"
            app:srcCompat="@drawable/gobacksinfondo"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/titulo"
            android:layout_width="700dp"
            android:layout_height="match_parent"
            android:fontFamily="@font/lily_script_one"
            android:gravity="center"
            android:text="Añade un Alimento"
            android:textColor="#027C68"
            android:textSize="35sp"
            android:textStyle="bold" />

        <ImageButton
            android:layout_width="100dp"
            android:layout_height="45dp"
            android:backgroundTint="#00FFFFFF"
            android:onClick="onClickReturn"
            android:visibility="invisible"
            app:srcCompat="@drawable/gobacksinfondo" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/lily_script_one"
            android:text="Actual"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#027C68"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/actualLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_weight="1"
            android:background="@drawable/bg_food_item"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/lily_script_one"
            android:text="Opciones"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#027C68"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/addLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_weight="1"
            android:background="@drawable/bg_food_item"
            android:textSize="18sp"/>


    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="Gramos"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#027C68"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/inputgr"
            android:hint="gr"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:background="@android:drawable/edit_text"
            android:inputType="textCapWords"
            android:padding="10dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnDecrementProt100"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="–"
            android:backgroundTint="#40027C68"
            android:minWidth="48dp" />

        <Button
            android:id="@+id/btnIncrementProt100"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="+"
            android:backgroundTint="#40027C68"
            android:minWidth="48dp"
            android:layout_marginRight="16dp"/>

        <Button
            android:id="@+id/buttonGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#027C68"

            android:textSize="18sp"
            android:text="Guardar Cambios" />
    </LinearLayout>


</LinearLayout>