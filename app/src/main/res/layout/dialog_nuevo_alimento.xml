<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#DDE9EFDF"
    android:padding="16dp">

    <!-- TÍTULO PRINCIPAL -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/registra_un_nuevo_alimento"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#027C68"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <!-- CONTENIDO SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Instrucciones -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/introduce_los_siguientes_datos_nutricionales_por_cada_100g_del_alimento"
                android:textSize="16sp"
                android:textColor="#333"
                android:paddingBottom="16dp" />

            <!-- Nombre del alimento -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nombre_del_alimento"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#027C68"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/inputAlimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:hint="@string/ej_manzana"
                android:background="@android:drawable/edit_text"
                android:inputType="textCapWords"
                android:padding="10dp"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <!-- Sección MACRONUTRIENTES -->
            <TextView
                android:text="@string/macronutrientes"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#027C68"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Lista de macronutrientes -->
            <TextView android:text="@string/pc" style="@style/FormLabel" />
            <EditText android:id="@+id/inputPC" style="@style/FormInput"  android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/energ_a_e_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputE100" style="@style/FormInput" android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/prote_nas_prot_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputProt100" style="@style/FormInput" android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/grasas_grasa_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputGrasa100" style="@style/FormInput"  android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/ags_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputAGS100" style="@style/FormInput"  android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/agmi_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputAGMI100" style="@style/FormInput" android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/agpi_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputAGPI100" style="@style/FormInput"  android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/colesterol_col_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputCol100" style="@style/FormInput" android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/hidratos_de_carbono_hc_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputHC100" style="@style/FormInput"  android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/fibra_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputFibra100" style="@style/FormInput"  android:autofillHints=""
                android:text="@string/_0" />

            <!-- Sección MICRONUTRIENTES -->
            <TextView
                android:text="@string/micronutrientes"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#027C68"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView android:text="@string/vitamina_c_vit_c_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputVitC100" style="@style/FormInput"  android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/vitamina_b6_vit_b6_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputVitB6100" style="@style/FormInput"  android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/vitamina_e_vit_e_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputVitE100" style="@style/FormInput"  android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/hierro_fe_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputFe100" style="@style/FormInput"  android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/sodio_na_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputNa100" style="@style/FormInput"  android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/calcio_ca_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputCa100" style="@style/FormInput"
                android:autofillHints=""
                android:text="@string/_0" />

            <TextView android:text="@string/potasio_k_100" style="@style/FormLabel" />
            <EditText android:id="@+id/inputK100" style="@style/FormInput"
                android:autofillHints=""
                android:text="@string/_0" />

        </LinearLayout>
    </ScrollView>

    <!-- BOTONES -->
    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:weightSum="2"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnCancelar"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancelar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#027C68"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnGuardar"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/guardar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#027C68" />
    </LinearLayout>

    <!-- MENSAJE DE ERROR -->
    <TextView
        android:id="@+id/txtMensajeErrorAlimento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#B00020"
        android:textSize="14sp"
        android:visibility="gone"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

</LinearLayout>
